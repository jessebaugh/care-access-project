   "source": [
    "import pandas as pd\n",
    "from geopy.geocoders import Nominatim\n",
    "from geopy.extra.rate_limiter import RateLimiter\n",
    "\n",
    "# Load raw clinic data\n",
    "clinics = pd.read_csv(\"../data/raw/clinics_raw.csv\")\n",
    "\n",
    "# Initialize geocoder\n",
    "geolocator = Nominatim(user_agent=\"care_access_project_modrnsn\")\n",
    "geocode = RateLimiter(geolocator.geocode, min_delay_seconds=1)\n",
    "\n",
    "# Create address column if needed\n",
    "if \"full_address\" not in clinics.columns:\n",
    "    clinics[\"full_address\"] = (\n",
    "        clinics[\"address\"] + \", \" + clinics[\"city\"] + \", \" + clinics[\"state\"]\n",
    "    )\n",
    "\n",
    "# Geocode\n",
    "latitudes = []\n",
    "longitudes = []\n",
    "\n",
    "for addr in clinics[\"full_address\"]:\n",
    "    try:\n",
    "        location = geocode(addr)\n",
    "        if location:\n",
    "            latitudes.append(location.latitude)\n",
    "            longitudes.append(location.longitude)\n",
    "        else:\n",
    "            latitudes.append(None)\n",
    "            longitudes.append(None)\n",
    "    except:\n",
    "        latitudes.append(None)\n",
    "        longitudes.append(None)\n",
    "\n",
    "clinics[\"latitude\"] = latitudes\n",
    "clinics[\"longitude\"] = longitudes\n",
    "\n",
    "# Save processed file\n",
    "clinics.to_csv(\"../data/processed/clinics_geocoded.csv\", index=False)\n",
    "\n",
    "clinics.head()\n"
   ]
  }
