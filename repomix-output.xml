    "# Center the map roughly on Seattle\n",
    "seattle_center = [47.6062, -122.3321]\n",
    "\n",
    "m = folium.Map(location=seattle_center, zoom_start=11)\n",
    "\n",
    "# Add clinic markers\n",
    "for _, row in clinics.dropna(subset=[\"latitude\", \"longitude\"]).iterrows():\n",
    "    folium.Marker(\n",
    "        location=[row[\"latitude\"], row[\"longitude\"]],\n",
    "        popup=row.get(\"name\", \"Clinic\"),\n",
    "        icon=folium.Icon(color=\"red\", icon=\"plus\", prefix=\"fa\")\n",
    "    ).add_to(m)\n",
    "\n",
    "m\n"
